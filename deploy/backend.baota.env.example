# 由 baota-init.sh 首次复制为 backend.env；真实文件禁止上传 GitHub。
# 宝塔兼容版使用普通 env_file：在单引号里填写值，尤其 bcrypt 的 $ 必须保留。
# 不在值后加注释，不使用 source 执行；不要混用其他部署方案的 raw 模板。
DASHSCOPE_API_KEY='replace-with-your-dashscope-key'
QWEN_MODEL='qwen-max'
QWEN_REWRITE_MODEL='qwen-flash'
DASHSCOPE_EMBEDDING_MODEL='text-embedding-v4'
RERANK_ENABLED='true'
RERANK_MODEL='qwen3-rerank'
DASHSCOPE_RERANK_BASE_URL='https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-api/v1'
ADMIN_USERNAME='admin'
ADMIN_PASSWORD_HASH='replace-with-bcrypt-hash'
SESSION_SECRET='replace-with-at-least-32-random-characters'
COOKIE_SECURE='true'
FRONTEND_ORIGINS='https://app.example.com'
# 宝塔 Nginx 必须覆盖 X-Forwarded-For；新 API 仅绑定回环端口。
TRUST_PROXY_HEADERS='true'
COZE_API_TOKEN='replace-with-your-coze-token'
COZE_WORKFLOW_ID='7687948198364037155'
COZE_APP_ID=''
AMAZON_FETCH_MODE='browser'
AMAZON_BROWSER_CHANNEL='chromium'
TZ='Asia/Shanghai'
