# 复制为 deploy/backend.env 后填写。raw 格式不加引号，不在值后面写注释。
# 这些值只注入后端容器，绝不能改成 VITE_ 开头或复制进前端代码。
DASHSCOPE_API_KEY=replace-with-your-dashscope-key
QWEN_MODEL=qwen-max
QWEN_REWRITE_MODEL=qwen-flash
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
RERANK_ENABLED=true
RERANK_MODEL=qwen3-rerank
DASHSCOPE_RERANK_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-api/v1
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
SESSION_SECRET=replace-with-at-least-32-random-characters
# SSH 隧道验收使用 HTTP；换到域名 HTTPS 时改 true 并重建 api 容器。
COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# API 未发布宿主机端口，只有本项目 Caddy 转发并覆盖此头。
TRUST_PROXY_HEADERS=true
COZE_API_TOKEN=replace-with-your-coze-token
COZE_WORKFLOW_ID=7687948198364037155
COZE_APP_ID=
AMAZON_FETCH_MODE=browser
# Dockerfile 安装的是 Playwright Chromium，不是 Windows 上的 Chrome。
AMAZON_BROWSER_CHANNEL=chromium
TZ=Asia/Shanghai
