# 与本机 Python 主版本保持一致；使用服务器已成功拉取的官方 ECR 镜像入口。
FROM public.ecr.aws/docker/library/python:3.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    AMAZON_FETCH_MODE=scrape_do TZ=Asia/Shanghai
WORKDIR /app
COPY backend/requirements.txt backend/requirements.txt
COPY backend/zhishiku/requirements.txt backend/zhishiku/requirements.txt
# 依赖先于业务代码复制；代码更新可复用依赖层，pip 下载缓存不进入最终镜像。
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --index-url https://mirrors.aliyun.com/pypi/simple --timeout 120 -r backend/requirements.txt \
    && pip check
# 商品采集通过 Scrape.do HTTPS API 完成，不安装 Chromium 或浏览器系统依赖。
# Playwright Python 包如被测试依赖引用仍可保留；本镜像不提供旧 browser 模式。
COPY backend/ backend/
# 宿主机四个挂载目录须归 UID 10001 所有；密钥和运行数据不会复制到镜像。
RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p backend/zhishiku/runtime backend/tuijian/runtime backend/remen/runtime backend/tupian/runtime \
    && chown -R appuser:appuser /app
USER appuser
EXPOSE 8000
# 单 worker 避免调度器重复运行；宝塔仅通过 127.0.0.1:18000 转发。
CMD ["python", "-m", "uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
