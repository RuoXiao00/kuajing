# Qwen 聊天与 Embedding 必填。不要把真实密钥提交到 Git。
DASHSCOPE_API_KEY=sk-your-key
QWEN_MODEL=qwen-max
QWEN_REWRITE_MODEL=qwen-flash
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# Qwen3 Rerank。这里填写包含 Workspace ID 的 compatible-api/v1 基础地址，
# 程序会自动追加 /reranks；不要填写 qwen3.7 的原生 text-rerank URL。
# 缺少或调用失败时会退回 Chroma 向量顺序，并在 health 标为 degraded。
RERANK_ENABLED=true
RERANK_MODEL=qwen3-rerank
DASHSCOPE_RERANK_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-api/v1

# 管理员配置：PASSWORD_HASH 必须是 bcrypt 哈希，不要写明文。
# 生成示例：python -c "import bcrypt; print(bcrypt.hashpw(b'你的密码', bcrypt.gensalt()).decode())"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$replace_with_your_bcrypt_hash
SESSION_SECRET=replace-with-at-least-32-random-characters

# 本地 HTTP 保持 false；公网 HTTPS 必须设为 true。
COOKIE_SECURE=false

# 逗号分隔，禁止 *。生产环境填写真实前端域名。
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 仅当请求先经过会清洗 X-Forwarded-For 的可信反向代理时才开启。
TRUST_PROXY_HEADERS=false

# Coze 中国区：只放后端。令牌需要 uploadFile 和工作流 run 权限。
COZE_API_TOKEN=replace-with-your-coze-token
COZE_WORKFLOW_ID=7687948198364037155
# 空间资源库工作流无需填写；迁入应用后填写应用 ID。
COZE_APP_ID=
# 可选：图片存档目录，默认 backend/tupian/runtime，独立于知识库。
# IMAGE_STORAGE_DIR=

# 仅在 GitHub Pages 的 Actions 仓库 Variables 中设置公开地址，不要填后端密钥。
# VITE_API_BASE_URL=https://api.your-domain.com
# VITE_ROUTER_MODE=hash
# VITE_BASE_PATH=/kuajing/
